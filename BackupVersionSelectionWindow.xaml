<Window x:Class="KaiZhongReleaseTool.BackupVersionSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择回滚备份版本" Icon="imges/logo64.ico" Width="620" Height="540" WindowStartupLocation="CenterOwner">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,15"><TextBlock x:Name="TitleTextBlock" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="备份按时间从新到旧排列，请单击需要回滚的版本。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
  <ListBox x:Name="VersionListBox" Grid.Row="1" FontSize="15" Padding="8" MouseDoubleClick="VersionListBox_MouseDoubleClick"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" Width="95" Margin="0,0,12,0" Background="#94A3B8" Click="Cancel_Click"/><Button Content="选择此版本" Width="115" Click="Confirm_Click"/></StackPanel>
 </Grid>
</Window>
