<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>imges\logo128.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);KaiZhongReleaseTool.Server\obj\**;KaiZhongReleaseTool.Server\bin\**;KaiZhongReleaseTool.Shared\obj\**;KaiZhongReleaseTool.Shared\bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.36" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="imges\*.ico;imges\*.png" />
    <Resource Include="imges\*.ico;imges\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="imges\" />
  </ItemGroup>

</Project>
