<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>imges\logo128.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);KaiZhongReleaseTool.Server\obj\**;KaiZhongReleaseTool.Server\bin\**;KaiZhongReleaseTool.Server.Updater\obj\**;KaiZhongReleaseTool.Server.Updater\bin\**;KaiZhongReleaseTool.Shared\obj\**;KaiZhongReleaseTool.Shared\bin\**</DefaultItemExcludes>
    <AssemblyName>凯中发布工具</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.36" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="imges\*.ico;imges\*.png" />
    <Resource Include="imges\*.ico;imges\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 服务端已拆分为独立 Windows 服务，不再编译进客户端 WPF。 -->
    <Compile Remove="ServerHost.cs;ServerWindow.xaml.cs;RoleSelectionWindow.xaml.cs;KaiZhongReleaseTool.Server\**\*.cs;KaiZhongReleaseTool.Server.Updater\**\*.cs" />
    <Page Remove="ServerWindow.xaml;RoleSelectionWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="imges\" />
  </ItemGroup>

</Project>
