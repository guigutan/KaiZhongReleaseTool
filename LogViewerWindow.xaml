<Window x:Class="KaiZhongReleaseTool.LogViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="查看日志" Icon="imges/logo64.ico" Width="920" Height="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="25"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="日志集（按创建日期）" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="LogSetListBox" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="LogSetListBox_SelectionChanged"/></Grid>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="TitleTextBlock" Text="请选择日志集" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><RichTextBox x:Name="LogRichTextBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderBrush="#C8E5F3"/></Grid>
 </Grid>
</Window>
