<Window x:Class="KaiZhongReleaseTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凯中发布工具 · 客户端" Icon="imges/logo64.ico" Height="850" Width="1420" MinHeight="760" MinWidth="1160" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="380" MinWidth="320" MaxWidth="620"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="620"/></Grid.ColumnDefinitions>
        <Canvas Grid.ColumnSpan="3" IsHitTestVisible="False" ClipToBounds="True" Margin="-24">
            <Ellipse Width="430" Height="430" Canvas.Left="-150" Canvas.Top="-190" Opacity="0.22"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#64B5FF"/><GradientStop Color="#0064B5FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
            <Ellipse Width="520" Height="520" Canvas.Left="850" Canvas.Top="430" Opacity="0.20"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#74E8AD"/><GradientStop Color="#0074E8AD" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        </Canvas>

        <GroupBox Grid.Column="0" Margin="0,0,12,0" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#E8F5FD" BorderBrush="#C8E5F3" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,0,12"><WrapPanel x:Name="ServerGroupFilterPanel"><CheckBox x:Name="AllServersFilterCheckBox" Content="全部" IsChecked="True" FontWeight="Bold" FontSize="14" Padding="5" Margin="0,2,12,2" Cursor="Hand" Click="AllServersFilterCheckBox_Click"/></WrapPanel></Border>
                <DataGrid x:Name="ServerDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent" RowHeight="26" ColumnHeaderHeight="42" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionChanged="ServerDataGrid_SelectionChanged" PreviewMouseRightButtonDown="ServerDataGrid_PreviewMouseRightButtonDown" MouseDoubleClick="ServerDataGrid_MouseDoubleClick">
                    <DataGrid.Resources>
                        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
                            <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#69ACE0" CornerRadius="5" Margin="2,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid>
                        </ControlTemplate>
                        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
                            <Grid Background="Transparent"><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#69ACE0" CornerRadius="5" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid>
                        </ControlTemplate>
                        <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/></Trigger></Style.Triggers></Style>
                        <Style x:Key="ServerCellTextStyle" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style>
                        <Style x:Key="ServerStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ServerCellTextStyle}"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E8F5FD"/><Setter Property="Foreground" Value="#31536D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#CBE4F3"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style></DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle><Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#202A36"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="在线"><Setter Property="Background" Value="#DDF7E8"/><Setter Property="Foreground" Value="#12653E"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="离线"><Setter Property="Background" Value="#FFE1E4"/><Setter Property="Foreground" Value="#9F2635"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="未检测"><Setter Property="Background" Value="#FFF3CB"/><Setter Property="Foreground" Value="#765900"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="检测中"><Setter Property="Background" Value="#FFF3CB"/><Setter Property="Foreground" Value="#765900"/></DataTrigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#202A36"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#087DD1"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
                        </Style.Triggers>
                    </Style></DataGrid.RowStyle>
                    <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
                    <DataGrid.ContextMenu><ContextMenu><ContextMenu.Resources><Style TargetType="Separator"><Setter Property="Margin" Value="8,8"/><Setter Property="Height" Value="5"/><Setter Property="Background" Value="#C9DEE9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Grid Height="5" Margin="8,0"><Border Height="1" Background="{TemplateBinding Background}" VerticalAlignment="Top"/><Border Height="1" Background="{TemplateBinding Background}" VerticalAlignment="Bottom"/></Grid></ControlTemplate></Setter.Value></Setter></Style></ContextMenu.Resources>
                        <MenuItem Header="远程服务器" Click="RemoteServer_Click"><MenuItem.Icon><Grid Width="16" Height="16"><Border Background="#3978C6" CornerRadius="3"/><Border Margin="2.5,2.5,2.5,5" Background="#EAF5FF" CornerRadius="1"/><Path Data="M 8,11 L 8,14 M 5.5,14 L 10.5,14" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round"/></Grid></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem Header="新增服务器" Click="AddServer_Click"><MenuItem.Icon><Grid Width="16" Height="16"><Ellipse Fill="#21B879"/><Path Data="M 8,4 L 8,12 M 4,8 L 12,8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></MenuItem.Icon></MenuItem>
                        <MenuItem Header="编辑服务器" Click="EditServer_Click"><MenuItem.Icon><Grid Width="16" Height="16"><Border Background="#278BF5" CornerRadius="8"/><Path Data="M 4,11 L 5,8 L 10.5,2.5 L 13.5,5.5 L 8,11 Z M 4,13 L 12,13" Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"/></Grid></MenuItem.Icon></MenuItem>
                        <MenuItem Header="删除服务器" Click="DeleteServer_Click"><MenuItem.Icon><Grid Width="16" Height="16"><Ellipse Fill="#E65867"/><Path Data="M 4,8 L 12,8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem x:Name="RefreshServersMenuItem" Header="刷新状态" Click="RefreshServers_Click"><MenuItem.Icon><Grid Width="16" Height="16"><Ellipse Fill="#16A6B6"/><Path Data="M 12.5,6 A 5,5 0 1 0 12,11 M 12.5,3 L 12.5,6 L 9.5,6" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Grid></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem Header="分组管理" Click="ManageGroups_Click"><MenuItem.Icon><Grid Width="16" Height="16"><Border Background="#8667D6" CornerRadius="8"/><Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0"/><Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"/><Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/></Grid></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem Header="发布回滚" Click="RollbackServer_Click"><MenuItem.Icon><Grid Width="16" Height="16"><Ellipse Fill="#E98A50"/><Path Data="M 5,5 L 2.8,7.2 L 5,9.4 M 3.2,7.2 L 9,7.2 A 3.5,3.5 0 0 1 9,14" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Grid></MenuItem.Icon></MenuItem>
                    </ContextMenu></DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="服务器" Binding="{Binding Name}" Width="Auto" ElementStyle="{StaticResource ServerCellTextStyle}"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="Auto" ElementStyle="{StaticResource ServerStatusTextStyle}"/>
                        <DataGridTextColumn Header="服务器IP" Binding="{Binding Host}" Width="Auto" ElementStyle="{StaticResource ServerCellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock x:Name="ServerCountTextBlock" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="右键列表可新增、刷新或管理服务器" Foreground="#91A0AF" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="4,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="16" Background="#E8F4FF" Margin="0,0,15,0"><Image Source="imges/logo64.png" Width="42" Height="42"/></Border>
                <StackPanel Grid.Column="1"><TextBlock Text="凯中发布工具" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="双击我打开本程序所在文件夹" Foreground="#3186C6" FontSize="14" FontWeight="SemiBold" Cursor="Hand" ToolTip="双击打开程序目录" Margin="0,6,0,0" MouseLeftButtonDown="OpenProgramFolder_MouseLeftButtonDown"/></StackPanel>
                <Border Grid.Column="2" Background="#E6F3FF" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  客户端" Foreground="#247DCC" FontWeight="SemiBold"/></Border>
            </Grid>
            <Border Grid.Row="1" Background="#EFFFFFFF" BorderBrush="#B8FFFFFF" BorderThickness="1" CornerRadius="18" Padding="20" Effect="{StaticResource CardShadow}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="SMOM项目：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="SmomProjectPathTextBox" Grid.Column="1" Margin="4,0,10,0" TextChanged="SmomProjectPathTextBox_TextChanged" ToolTip="可输入项目根目录或 Projects\SMOM 下的任意深层目录"/>
                    <Button Grid.Column="2" Content="选择" Background="#DCEFFC" Foreground="#246A9D" Click="SelectSmomFolderButton_Click"/>
                    <TextBlock x:Name="ScheduleServerPathTextBlock" Grid.Row="1" Grid.ColumnSpan="3" Text="SIE.ScheduleServer：未能识别路径" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WebApiHostPathTextBlock" Grid.Row="2" Grid.ColumnSpan="3" Text="SIE.WebApiHost：未能识别路径" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WebClientPathTextBlock" Grid.Row="3" Grid.ColumnSpan="3" Text="WebClient：未能识别路径" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WpfClientPathTextBlock" Grid.Row="4" Grid.ColumnSpan="3" Text="WpfClient：未能识别路径" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <DockPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Button x:Name="PublishToServerButton" DockPanel.Dock="Right" Content="上传并发布" Width="132" Margin="10,0,0,0" BorderBrush="#087D4D" BorderThickness="1" Click="PublishToServerButton_Click"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#24C883"/><GradientStop Color="#078C57" Offset="1"/></LinearGradientBrush></Button.Background><Button.Effect><DropShadowEffect Color="#087D4D" BlurRadius="13" ShadowDepth="3" Opacity="0.38"/></Button.Effect></Button>
                        <Button x:Name="GetDllButton" DockPanel.Dock="Right" Content="获取DLL" Width="110" Margin="12,0,0,0" BorderBrush="#176FC1" BorderThickness="1" Click="GetDllButton_Click"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#48A9FF"/><GradientStop Color="#1674D1" Offset="1"/></LinearGradientBrush></Button.Background><Button.Effect><DropShadowEffect Color="#176FC1" BlurRadius="12" ShadowDepth="3" Opacity="0.32"/></Button.Effect></Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="SpecifiedDllRadioButton" Content="获取指定DLL" GroupName="DllMode" IsChecked="True" Margin="0,0,14,0" Checked="DllModeRadioButton_Checked"/>
                            <RadioButton x:Name="AllDllRadioButton" Content="获取全量DLL" GroupName="DllMode" Checked="DllModeRadioButton_Checked"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DllEnvironmentTextBlock" Text="未能识别DLL环境" Foreground="#D69A00" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="DllCountTextBlock" Text="待获取：0 个" Foreground="#397897" FontWeight="SemiBold" Margin="16,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <GroupBox Grid.Row="2" Header="任务参数" Margin="0" Visibility="Collapsed">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="操作类型" VerticalAlignment="Center" Margin="0,5"/><ComboBox x:Name="CommandTypeComboBox" Grid.Column="1" Margin="4" SelectionChanged="CommandTypeComboBox_SelectionChanged"/>
                    <TextBlock Grid.Column="2" Text="服务名称" VerticalAlignment="Center" Margin="12,5,0,5"/><TextBox x:Name="ServiceNameTextBox" Grid.Column="3" Margin="4" ToolTip="服务操作时填写，例如 Spooler"/>
                    <TextBlock Grid.Row="1" Text="源路径" VerticalAlignment="Center" Margin="0,5"/><TextBox x:Name="SourcePathTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="4"/><Button x:Name="BrowseFolderButton" Grid.Row="1" Grid.Column="3" Margin="4" Content="选择文件夹" Click="BrowseFolderButton_Click" IsEnabled="False"/>
                    <TextBlock Grid.Row="2" Text="目标路径" VerticalAlignment="Center" Margin="0,5"/><TextBox x:Name="DestinationPathTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="4"/>
                    <TextBlock Grid.Row="3" Text="修改内容" VerticalAlignment="Top" Margin="0,9"/><TextBox x:Name="ContentTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="78" Margin="4" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="3" Margin="0,16,0,0" Padding="20,20,20,0">
                <GroupBox.Header><StackPanel Orientation="Horizontal">
                    <TextBlock Text="执行结果"/><TextBlock Text="查看日志" Foreground="#278BF5" Cursor="Hand" Margin="22,0,0,0" TextDecorations="Underline" MouseLeftButtonDown="ViewLogs_MouseLeftButtonDown"/></StackPanel>
                </GroupBox.Header><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBox x:Name="ResultTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/><RichTextBox x:Name="PublishLogRichTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Microsoft YaHei UI" FontSize="14" Visibility="Collapsed" Background="Transparent" BorderThickness="0"/></Grid>
                    <TextBlock Grid.Row="1" Text="Copyright ©2026 深圳凯中精密技术股份有限公司 版权所有 by tanxianzhong" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7A91A3" FontSize="12" Margin="2" Padding="0" LineHeight="12"/>
                </Grid></GroupBox>
        </Grid>
    </Grid>
</Window>
