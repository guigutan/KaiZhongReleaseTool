<Window x:Class="KaiZhongReleaseTool.PublishServerSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择发布服务器" Icon="imges/logo64.ico" Height="660" Width="920" MinHeight="560" MinWidth="760" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Canvas Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True" Margin="-28">
            <Ellipse Width="430" Height="430" Canvas.Left="-170" Canvas.Top="-210" Opacity="0.20"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#66B9FF"/><GradientStop Color="#0066B9FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
            <Ellipse Width="500" Height="500" Canvas.Left="650" Canvas.Top="310" Opacity="0.18"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#6DE6AC"/><GradientStop Color="#006DE6AC" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        </Canvas>

        <Grid Margin="2,0,2,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="58" Height="58" CornerRadius="17" Background="#E7F4FF" Margin="0,0,16,0"><Image Source="imges/logo64.png" Width="43" Height="43"/></Border>
            <StackPanel Grid.Column="1"><TextBlock Text="选择发布服务器" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="选择一台、多台或按分组快速选择目标服务器" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
            <Border Grid.Column="2" Background="#E5FAEE" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  发布准备" Foreground="#168752" FontWeight="SemiBold"/></Border>
        </Grid>

        <Border Grid.Row="1" Background="#F4FAFF" BorderBrush="#C8E5F3" BorderThickness="1" CornerRadius="15" Padding="16,9" Margin="0,0,0,10"><WrapPanel><TextBlock Text="显示：" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><CheckBox x:Name="ShowAllCheckBox" Content="全部显示" IsChecked="True" Margin="0,2,18,2" Padding="5" Click="DisplayFilterCheckBox_Click"/><CheckBox x:Name="ShowSelectedCheckBox" Content="仅显示勾选" Margin="0,2,18,2" Padding="5" Click="DisplayFilterCheckBox_Click"/><CheckBox x:Name="ShowUnselectedCheckBox" Content="仅显示未勾选" Margin="0,2,18,2" Padding="5" Click="DisplayFilterCheckBox_Click"/></WrapPanel></Border>

        <Border Grid.Row="2" Background="#EFFFFFFF" BorderBrush="#C8E5F3" BorderThickness="1" CornerRadius="15" Padding="16,12" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel x:Name="GroupCheckBoxPanel" VerticalAlignment="Center">
                    <CheckBox x:Name="SelectAllCheckBox" Content="全选" IsThreeState="True" FontWeight="Bold" FontSize="14" Padding="7,5" Margin="0,2,12,2" Cursor="Hand" Click="SelectAllCheckBox_Click"/>
                </WrapPanel>
                <Border Grid.Column="1" Background="#E8F4FF" CornerRadius="13" Padding="13,7" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SelectionCountTextBlock" Foreground="#247DCC" FontWeight="SemiBold"/></Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#F5FFFFFF" BorderBrush="#C8E5F3" BorderThickness="1" CornerRadius="17" Padding="5" Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="ServerSelectionDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="37" ColumnHeaderHeight="43" SelectionMode="Extended" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DFEBF2" BorderThickness="0" Background="Transparent">
                <DataGrid.Resources>
                    <Style x:Key="LargeServerCheckBoxStyle" TargetType="CheckBox"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="1.4" ScaleY="1.4"/></Setter.Value></Setter></Style>
                    <Style x:Key="CenteredServerTextStyle" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EAF6FD"/><Setter Property="Foreground" Value="#31536D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#CBE4F3"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style></DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></DataGrid.CellStyle>
                <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="#80FFFFFF"/><Setter Property="Foreground" Value="#263548"/><Style.Triggers>
                    <DataTrigger Binding="{Binding Server.Status}" Value="在线"><Setter Property="Background" Value="#E5F9ED"/></DataTrigger>
                    <DataTrigger Binding="{Binding Server.Status}" Value="离线"><Setter Property="Background" Value="#FFF0F1"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEFFF"/><Setter Property="Foreground" Value="#176FAC"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CBE7FF"/><Setter Property="Foreground" Value="#164E78"/></Trigger>
                </Style.Triggers></Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="选择" Width="78"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource LargeServerCheckBoxStyle}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="服务器" Binding="{Binding Server.Name}" ElementStyle="{StaticResource CenteredServerTextStyle}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="分组" Binding="{Binding Server.GroupName}" ElementStyle="{StaticResource CenteredServerTextStyle}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="服务器IP" Binding="{Binding Server.Host}" ElementStyle="{StaticResource CenteredServerTextStyle}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Server.Status}" ElementStyle="{StaticResource CenteredServerTextStyle}" IsReadOnly="True" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="2,18,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#1BAA72" Margin="0,0,8,0"/><TextBlock Text="确认后将进入下一步发布流程" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Width="100" Background="#94A3B8" Margin="0,0,12,0" Click="Cancel_Click"/><Button Content="确认选择  →" Width="130" Click="Confirm_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
