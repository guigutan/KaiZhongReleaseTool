<Window x:Class="KaiZhongReleaseTool.RemoteDirectoryPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择服务端目录" Icon="imges/logo64.ico" Height="620" Width="760" MinHeight="500" MinWidth="620" WindowStartupLocation="CenterOwner">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18"><TextBlock Text="选择服务端目录" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ServerTextBlock" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="磁盘" Width="76" Background="#4F9FDE" Click="Drives_Click"/><Button Content="上一级" Grid.Column="1" Width="82" Margin="8,0" Background="#4F9FDE" Click="Up_Click"/>
            <TextBox x:Name="CurrentPathTextBox" Grid.Column="2" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </Grid>
        <Border Grid.Row="2" Background="#F4FFFFFF" BorderBrush="#C8E5F3" BorderThickness="1" CornerRadius="14" Padding="7" Effect="{StaticResource CardShadow}">
            <ListBox x:Name="DirectoryListBox" FontSize="14" BorderThickness="0" Background="Transparent" MouseDoubleClick="DirectoryListBox_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="▣" Foreground="#3186C6" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Border>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Foreground="{StaticResource MutedBrush}" Margin="2,12,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" Width="95" Background="#94A3B8" Margin="0,0,10,0" Click="Cancel_Click"/><Button x:Name="SelectButton" Content="选择当前目录" Width="125" IsEnabled="False" Click="Select_Click"/></StackPanel>
    </Grid>
</Window>
