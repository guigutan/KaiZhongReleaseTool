<Window x:Class="KaiZhongReleaseTool.RoleSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凯中发布工具" Icon="imges/logo64.ico" Height="460" Width="680" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource AppBackground}" CornerRadius="22" BorderBrush="#E5E7F2" BorderThickness="1" Effect="{StaticResource CardShadow}">
        <Grid Margin="38">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="×" FontSize="20" Width="34" Height="34" Padding="0" Background="#18FFFFFF" Foreground="#64748B" Click="Close_Click"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,26">
                <Border Width="58" Height="58" CornerRadius="18" Background="#187367F0" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Image Source="imges/logo64.png" Width="46" Height="46"/>
                </Border>
                <TextBlock Text="欢迎使用凯中发布工具" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="选择本次程序的运行方式" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Margin="5,0,10,0" Background="White" Foreground="{StaticResource InkBrush}" Click="Client_Click">
                    <StackPanel Margin="12"><TextBlock Text="⌁" FontSize="34" Foreground="#4F8DF7" HorizontalAlignment="Center"/><TextBlock Text="客户端" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="连接服务端并发送任务" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Margin="10,0,5,0" Background="#278BF5" Click="Server_Click">
                    <StackPanel Margin="12"><TextBlock Text="◫" FontSize="34" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="服务端" FontSize="18" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="监听并安全执行任务" Foreground="#DCD8FF" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                </Button>
            </Grid>
            <TextBlock Grid.Row="3" Text="关闭主窗口后，程序仍会在系统托盘中运行" Foreground="#8A94A6" HorizontalAlignment="Center" Margin="0,26,0,0"/>
        </Grid>
    </Border>
</Window>
