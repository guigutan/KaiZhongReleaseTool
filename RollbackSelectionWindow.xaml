<Window x:Class="KaiZhongReleaseTool.RollbackSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="批量发布回滚" Icon="imges/logo64.ico" Height="680" Width="1040" MinHeight="580" MinWidth="860" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Canvas Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True" Margin="-28"><Ellipse Width="430" Height="430" Canvas.Left="-170" Canvas.Top="-210" Opacity="0.20"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#66B9FF"/><GradientStop Color="#0066B9FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse><Ellipse Width="520" Height="520" Canvas.Left="760" Canvas.Top="330" Opacity="0.18"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#F0A37A"/><GradientStop Color="#00F0A37A" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse></Canvas>
  <Grid Margin="2,0,2,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="58" Height="58" CornerRadius="17" Background="#FFF0E8" Margin="0,0,16,0"><Image Source="imges/logo64.png" Width="43" Height="43"/></Border><StackPanel Grid.Column="1"><TextBlock Text="批量发布回滚" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="勾选目标服务器，并为每台服务器选择需要还原的历史备份版本" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/></StackPanel><Border Grid.Column="2" Background="#FFF0E8" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  回滚准备" Foreground="#C7602D" FontWeight="SemiBold"/></Border></Grid>
  <Border Grid.Row="1" Background="#FFF8F3" BorderBrush="#F0D2C0" BorderThickness="1" CornerRadius="15" Padding="16,9" Margin="0,0,0,10"><WrapPanel><TextBlock Text="显示：" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><CheckBox x:Name="ShowAllCheckBox" Content="全部显示" IsChecked="True" Margin="0,2,18,2" Padding="5" Click="DisplayFilterCheckBox_Click"/><CheckBox x:Name="ShowSelectedCheckBox" Content="仅显示勾选" Margin="0,2,18,2" Padding="5" Click="DisplayFilterCheckBox_Click"/><CheckBox x:Name="ShowUnselectedCheckBox" Content="仅显示未勾选" Margin="0,2,18,2" Padding="5" Click="DisplayFilterCheckBox_Click"/></WrapPanel></Border>
  <Border Grid.Row="2" Background="#EFFFFFFF" BorderBrush="#C8E5F3" BorderThickness="1" CornerRadius="15" Padding="16,12" Margin="0,0,0,14" Effect="{StaticResource CardShadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel x:Name="GroupCheckBoxPanel" VerticalAlignment="Center"><CheckBox x:Name="SelectAllCheckBox" Content="全选" IsThreeState="True" FontWeight="Bold" FontSize="14" Padding="7,5" Margin="0,2,12,2" Cursor="Hand" Click="SelectAllCheckBox_Click"/></WrapPanel><Border Grid.Column="1" Background="#FFF0E8" CornerRadius="13" Padding="13,7" Margin="14,0,0,0"><TextBlock x:Name="SelectionCountTextBlock" Text="已选择 0 台" Foreground="#C7602D" FontWeight="SemiBold"/></Border></Grid></Border>
  <Border Grid.Row="3" Background="#F5FFFFFF" BorderBrush="#C8E5F3" BorderThickness="1" CornerRadius="17" Padding="5" Effect="{StaticResource CardShadow}">
   <DataGrid x:Name="ServerDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="39" ColumnHeaderHeight="43" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DFEBF2" BorderThickness="0" Background="Transparent">
    <DataGrid.Resources><Style x:Key="LargeRollbackCheckBoxStyle" TargetType="CheckBox"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="1.4" ScaleY="1.4"/></Setter.Value></Setter></Style><Style x:Key="CenteredRollbackTextStyle" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style><Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CenteredRollbackTextStyle}"><Setter Property="HorizontalAlignment" Value="Center"/><Style.Triggers><DataTrigger Binding="{Binding Server.Status}" Value="在线"><Setter Property="Foreground" Value="#13844F"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger><DataTrigger Binding="{Binding Server.Status}" Value="离线"><Setter Property="Foreground" Value="#C33445"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></DataGrid.Resources>
    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EAF6FD"/><Setter Property="Foreground" Value="#31536D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#CBE4F3"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style></DataGrid.ColumnHeaderStyle>
    <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></DataGrid.CellStyle>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="#80FFFFFF"/><Setter Property="Foreground" Value="#263548"/><Style.Triggers><DataTrigger Binding="{Binding Server.Status}" Value="在线"><Setter Property="Background" Value="#E5F9ED"/></DataTrigger><DataTrigger Binding="{Binding Server.Status}" Value="离线"><Setter Property="Background" Value="#FFF0F1"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEFFF"/><Setter Property="Foreground" Value="#176FAC"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CBE7FF"/><Setter Property="Foreground" Value="#164E78"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="选择" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource LargeRollbackCheckBoxStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="ServerCheckBox_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="服务器" Binding="{Binding Server.Name}" ElementStyle="{StaticResource CenteredRollbackTextStyle}" Width="1.6*" IsReadOnly="True"/>
     <DataGridTextColumn Header="分组" Binding="{Binding Server.GroupName}" ElementStyle="{StaticResource CenteredRollbackTextStyle}" Width="*" IsReadOnly="True"/>
     <DataGridTextColumn Header="服务器IP" Binding="{Binding Server.Host}" ElementStyle="{StaticResource CenteredRollbackTextStyle}" Width="1.3*" IsReadOnly="True"/>
     <DataGridTextColumn Header="状态" Binding="{Binding Server.Status}" ElementStyle="{StaticResource StatusTextStyle}" Width="82" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="回滚备份版本" Width="2.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="5,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedBackupFile, TargetNullValue=尚未选择}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" Foreground="#384E62"/><Button Grid.Column="1" Content="选择版本" Padding="8,6" Tag="{Binding}" Click="SelectVersion_Click"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <Grid Grid.Row="4" Margin="2,18,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#E58A55" Margin="0,0,8,0"/><TextBlock Text="所有勾选服务器在线且已选择备份版本后，才能统一回滚" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" Width="100" Background="#94A3B8" Margin="0,0,12,0" Click="Cancel_Click"/><Button Content="确认回滚  →" Width="135" Background="#E58A55" Click="Confirm_Click"/></StackPanel></Grid>
 </Grid>
</Window>
