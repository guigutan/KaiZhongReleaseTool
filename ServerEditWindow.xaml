<Window x:Class="KaiZhongReleaseTool.ServerEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器配置" Icon="imges/logo64.ico" Height="650" Width="900" MinHeight="580" MinWidth="780" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" CornerRadius="16" Background="#E8F4FF" Margin="0,0,15,0"><Image Source="imges/logo64.png" Width="40" Height="40"/></Border>
            <StackPanel Grid.Column="1"><TextBlock Text="服务器配置" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="维护服务器连接、远程桌面和发布备份信息" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#C8E5F3" BorderThickness="1" Padding="4">
            <TabItem Header="基本信息">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,14,18"><TextBlock Text="服务器名称" Margin="0,0,0,7"/><TextBox x:Name="NameTextBox"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,18"><TextBlock Text="服务器分组" Margin="0,0,0,7"/><ComboBox x:Name="GroupComboBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,14,18"><TextBlock Text="IP 地址或主机名" Margin="0,0,0,7"/><TextBox x:Name="HostTextBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,18"><TextBlock Text="服务端口" Margin="0,0,0,7"/><TextBox x:Name="PortTextBox" Text="5050"/></StackPanel>
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="#DCEAF2" Margin="0,2,0,20"/>
                    <StackPanel Grid.Row="3" Margin="0,0,14,18"><TextBlock Text="远程桌面账户" Margin="0,0,0,7"/><TextBox x:Name="UsernameTextBox" ToolTip="本地账户：服务器IP/administrator 或 ./administrator；AD域账户：kz.com/user1。正反斜杠均可。"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="14,0,0,18"><TextBlock Text="远程端口" Margin="0,0,0,7"/><TextBox x:Name="RemotePortTextBox" Text="3389"/></StackPanel>
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="远程桌面密码（明文保存）" Margin="0,0,0,7"/><TextBox x:Name="PasswordTextBox" ToolTip="密码将直接保存在 SQLite 数据库中"/><TextBlock Text="安全提醒：远程桌面密码会按当前设置以明文写入 SQLite 数据库。" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/></StackPanel>
                </Grid></ScrollViewer>
            </TabItem>

            <TabItem Header="发布前备份">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="26"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="路径为服务端本机目录；源路径留空表示该项目不参与备份。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
                    <TextBlock Grid.Row="1" Text="SIE.ScheduleServer：" VerticalAlignment="Center"/><TextBox x:Name="ScheduleServerBackupPathTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/><Button Grid.Row="1" Grid.Column="2" Content="选择" Margin="9,5,0,5" Tag="Schedule" Click="SelectRemoteDirectory_Click"/>
                    <TextBlock Grid.Row="2" Text="SIE.WebApiHost：" VerticalAlignment="Center"/><TextBox x:Name="WebApiHostBackupPathTextBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/><Button Grid.Row="2" Grid.Column="2" Content="选择" Margin="9,5,0,5" Tag="Api" Click="SelectRemoteDirectory_Click"/>
                    <TextBlock Grid.Row="3" Text="WebClient：" VerticalAlignment="Center"/><TextBox x:Name="WebClientBackupPathTextBox" Grid.Row="3" Grid.Column="1" Margin="0,5"/><Button Grid.Row="3" Grid.Column="2" Content="选择" Margin="9,5,0,5" Tag="Web" Click="SelectRemoteDirectory_Click"/>
                    <TextBlock Grid.Row="4" Text="WpfClient：" VerticalAlignment="Center"/><TextBox x:Name="WpfClientBackupPathTextBox" Grid.Row="4" Grid.Column="1" Margin="0,5"/><Button Grid.Row="4" Grid.Column="2" Content="选择" Margin="9,5,0,5" Tag="Wpf" Click="SelectRemoteDirectory_Click"/>
                    <Border Grid.Row="5" Grid.ColumnSpan="3" Height="1" Background="#DCEAF2" Margin="0,17"/>
                    <TextBlock Grid.Row="6" Text="备份到：" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox x:Name="BackupDestinationPathTextBox" Grid.Row="6" Grid.Column="1" Margin="0,5"/><Button Grid.Row="6" Grid.Column="2" Content="选择" Margin="9,5,0,5" Tag="Destination" Click="SelectRemoteDirectory_Click"/>
                </Grid></ScrollViewer>
            </TabItem>
            <TabItem Header="对应服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="26">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="填写各应用对应的 Windows 服务名。留空表示发布该应用时不停止、也不重启服务。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
                        <TextBlock Grid.Row="1" Text="SIE.ScheduleServer：" VerticalAlignment="Center"/><TextBox x:Name="ScheduleServerServiceNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6" ToolTip="请输入 Windows 服务名，留空表示不处理"/>
                        <TextBlock Grid.Row="2" Text="SIE.WebApiHost：" VerticalAlignment="Center"/><TextBox x:Name="WebApiHostServiceNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" ToolTip="请输入 Windows 服务名，留空表示不处理"/>
                        <TextBlock Grid.Row="3" Text="WebClient：" VerticalAlignment="Center"/><TextBox x:Name="WebClientServiceNameTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6" ToolTip="请输入 Windows 服务名，留空表示不处理"/>
                        <TextBlock Grid.Row="4" Text="WpfClient：" VerticalAlignment="Center"/><TextBox x:Name="WpfClientServiceNameTextBox" Grid.Row="4" Grid.Column="1" Margin="0,6" ToolTip="请输入 Windows 服务名，留空表示不处理"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" Width="100" Margin="0,0,12,0" Background="#94A3B8" Click="Cancel_Click"/><Button Content="保存" Width="100" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
