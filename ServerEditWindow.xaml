<Window x:Class="KaiZhongReleaseTool.ServerEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器配置" Icon="imges/logo64.ico" Height="840" Width="980" MinHeight="720" MinWidth="860" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" CornerRadius="16" Background="#E8F4FF" Margin="0,0,15,0"><Image Source="imges/logo64.png" Width="40" Height="40"/></Border>
            <StackPanel Grid.Column="1"><TextBlock Text="服务器配置" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="CurrentEditingTextBlock" Text="当前编辑&gt;&gt; 新增服务器" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
            <ToggleButton x:Name="EditToggleButton" Grid.Column="2" Width="56" Height="30" VerticalAlignment="Center" Cursor="Hand" ToolTip="打开后允许编辑服务器配置">
                <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Background" Value="#AEB8C2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="SwitchTrack" Width="56" Height="30" Background="{TemplateBinding Background}" CornerRadius="15"><Ellipse x:Name="SwitchThumb" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/></Ellipse.Effect></Ellipse></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#145DA0"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ToggleButton.Style>
            </ToggleButton>
        </Grid>
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#C8E5F3" BorderThickness="1" Padding="4">
            <TabItem Header="基本信息">
                <ScrollViewer IsEnabled="{Binding IsChecked, ElementName=EditToggleButton}" VerticalScrollBarVisibility="Auto"><Grid Margin="26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,14,18"><TextBlock Text="服务器名称" Margin="0,0,0,7"/><TextBox x:Name="NameTextBox" TextChanged="EditingIdentity_TextChanged"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,18"><TextBlock Text="服务器分组" Margin="0,0,0,7"/><ComboBox x:Name="GroupComboBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,14,18"><TextBlock Text="IP 地址或主机名" Margin="0,0,0,7"/><TextBox x:Name="HostTextBox" TextChanged="EditingIdentity_TextChanged"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,18"><TextBlock Text="服务端口" Margin="0,0,0,7"/><TextBox x:Name="PortTextBox" Text="5050"/></StackPanel>
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="#DCEAF2" Margin="0,2,0,20"/>
                    <StackPanel Grid.Row="3" Margin="0,0,14,18"><TextBlock Text="远程桌面账户" Margin="0,0,0,7"/><TextBox x:Name="UsernameTextBox" ToolTip="本地账户：服务器IP/administrator 或 ./administrator；AD域账户：kz.com/user1。正反斜杠均可。"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="14,0,0,18"><TextBlock Text="远程端口" Margin="0,0,0,7"/><TextBox x:Name="RemotePortTextBox" Text="3389"/></StackPanel>
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="远程桌面密码" Margin="0,0,0,7"/><TextBox x:Name="PasswordTextBox"/></StackPanel>
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="发布梯队，第：" VerticalAlignment="Center" FontWeight="SemiBold"/><ComboBox x:Name="ReleaseTierComboBox" Width="90" Margin="8,0" IsEditable="False"/><TextBlock Text="梯队" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                        <TextBlock Text="对于同组（同属地）的双备服务器，要有1台属于第1发布梯队，其他请设为第2发布梯队。" Foreground="#47677D" Margin="0,13,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="如两台API服务器，请设置其中一台为第1发布梯队，两台Web服务器，也请设置其中一台为第1发布梯队。" Foreground="#47677D" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>
            <TabItem Header="发布前备份">
                <ScrollViewer IsEnabled="{Binding IsChecked, ElementName=EditToggleButton}" VerticalScrollBarVisibility="Auto"><Grid Margin="26">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="4" Text="路径和服务名都指向服务端本机；多个服务名可用中英文逗号分隔。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
                    <TextBlock Grid.Row="1" Grid.RowSpan="2" Text="SIE.ScheduleServer" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="路径：" VerticalAlignment="Center"/><TextBox x:Name="ScheduleServerBackupPathTextBox" Grid.Row="1" Grid.Column="2" Margin="0,4"/><Button Grid.Row="1" Grid.Column="3" Content="选择" Margin="9,4,0,4" Tag="Schedule" Click="SelectRemoteDirectory_Click"/><TextBlock Grid.Row="2" Grid.Column="1" Text="服务：" VerticalAlignment="Center"/><TextBox x:Name="ScheduleServerServiceNameTextBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4" ToolTip="多个服务用逗号分隔"/>
                    <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" Background="#B9DDEC" Margin="0,10"/>
                    <TextBlock Grid.Row="4" Grid.RowSpan="2" Text="SIE.WebApiHost" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Row="4" Grid.Column="1" Text="路径：" VerticalAlignment="Center"/><TextBox x:Name="WebApiHostBackupPathTextBox" Grid.Row="4" Grid.Column="2" Margin="0,4"/><Button Grid.Row="4" Grid.Column="3" Content="选择" Margin="9,4,0,4" Tag="Api" Click="SelectRemoteDirectory_Click"/><TextBlock Grid.Row="5" Grid.Column="1" Text="服务：" VerticalAlignment="Center"/><TextBox x:Name="WebApiHostServiceNameTextBox" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4" ToolTip="多个服务用逗号分隔"/>
                    <Border Grid.Row="6" Grid.ColumnSpan="4" Height="1" Background="#B9DDEC" Margin="0,10"/>
                    <TextBlock Grid.Row="7" Grid.RowSpan="2" Text="WebClient" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Row="7" Grid.Column="1" Text="路径：" VerticalAlignment="Center"/><TextBox x:Name="WebClientBackupPathTextBox" Grid.Row="7" Grid.Column="2" Margin="0,4"/><Button Grid.Row="7" Grid.Column="3" Content="选择" Margin="9,4,0,4" Tag="Web" Click="SelectRemoteDirectory_Click"/><TextBlock Grid.Row="8" Grid.Column="1" Text="服务：" VerticalAlignment="Center"/><TextBox x:Name="WebClientServiceNameTextBox" Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4" ToolTip="多个服务用逗号分隔"/>
                    <Border Grid.Row="9" Grid.ColumnSpan="4" Height="1" Background="#B9DDEC" Margin="0,10"/>
                    <TextBlock Grid.Row="10" Grid.RowSpan="2" Text="WpfClient" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Row="10" Grid.Column="1" Text="路径：" VerticalAlignment="Center"/><TextBox x:Name="WpfClientBackupPathTextBox" Grid.Row="10" Grid.Column="2" Margin="0,4"/><Button Grid.Row="10" Grid.Column="3" Content="选择" Margin="9,4,0,4" Tag="Wpf" Click="SelectRemoteDirectory_Click"/><TextBlock Grid.Row="11" Grid.Column="1" Text="服务：" VerticalAlignment="Center"/><TextBox x:Name="WpfClientServiceNameTextBox" Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,4" ToolTip="留空时不启停服务"/>
                    <Border Grid.Row="12" Grid.ColumnSpan="4" Height="1" Background="#8FC7DF" Margin="0,14"/>
                    <TextBlock Grid.Row="13" Grid.ColumnSpan="2" Text="备份到：" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox x:Name="BackupDestinationPathTextBox" Grid.Row="13" Grid.Column="2" Margin="0,4"/><Button Grid.Row="13" Grid.Column="3" Content="选择" Margin="9,4,0,4" Tag="Destination" Click="SelectRemoteDirectory_Click"/>
                </Grid></ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="取消" Width="100" Margin="0,0,12,0" Background="#94A3B8" Click="Cancel_Click"/><Button Content="保存" Width="100" IsEnabled="{Binding IsChecked, ElementName=EditToggleButton}" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
