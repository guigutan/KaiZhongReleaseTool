<Window x:Class="KaiZhongReleaseTool.ServerEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器配置" Icon="imges/logo64.ico" Height="560" Width="560" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22"><TextBlock Text="服务器配置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="发布服务与远程桌面连接信息" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="服务器名称" Margin="0,0,0,6"/><TextBox x:Name="NameTextBox"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="服务器分组" Margin="0,0,0,6"/><ComboBox x:Name="GroupComboBox"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="IP 地址或主机名" Margin="0,0,0,6"/><TextBox x:Name="HostTextBox"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="服务端口" Margin="0,0,0,6"/><TextBox x:Name="PortTextBox" Text="5050"/></StackPanel>
        </Grid>
        <Border Grid.Row="3" Height="1" Background="#DCEAF2" Margin="0,5,0,18"/>
        <StackPanel Grid.Row="4" Margin="0,0,0,14"><TextBlock Text="远程桌面账户" Margin="0,0,0,6"/><TextBox x:Name="UsernameTextBox" ToolTip="例如：administrator 或 域名\用户名"/></StackPanel>
        <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="远程桌面密码（明文保存）" Margin="0,0,0,6"/><TextBox x:Name="PasswordTextBox" ToolTip="密码将直接保存在 SQLite 数据库中"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="远程端口" Margin="0,0,0,6"/><TextBox x:Name="RemotePortTextBox" Text="3389"/></StackPanel>
        </Grid>
        <TextBlock Grid.Row="6" Text="安全提醒：远程桌面密码会按当前设置以明文写入 SQLite 数据库。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Margin="0,0,10,0" Background="#94A3B8" Click="Cancel_Click"/>
            <Button Content="保存" Width="90" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
