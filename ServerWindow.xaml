<Window x:Class="KaiZhongReleaseTool.ServerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凯中发布工具 · 服务端" Icon="imges/logo64.ico" Height="650" Width="900" MinHeight="560" MinWidth="740" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Canvas Grid.RowSpan="4" IsHitTestVisible="False" ClipToBounds="True" Margin="-28">
            <Ellipse Width="460" Height="460" Canvas.Left="-190" Canvas.Top="-220" Opacity="0.20"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#82E9B2"/><GradientStop Color="#0082E9B2" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
            <Ellipse Width="530" Height="530" Canvas.Left="610" Canvas.Top="300" Opacity="0.22"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#62B8FF"/><GradientStop Color="#0062B8FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        </Canvas>
        <Grid Margin="4,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="16" Background="#E8FFF2" Margin="0,0,15,0"><Image Source="imges/logo64.png" Width="42" Height="42"/></Border>
            <StackPanel Grid.Column="1"><TextBlock Text="服务中心" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="接收、执行并记录来自客户端的远程任务" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
            <Border Grid.Column="2" Background="#E5FAEE" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  服务端" Foreground="#168752" FontWeight="SemiBold"/></Border>
        </Grid>
        <GroupBox Grid.Row="1" Header="监听配置">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                <TextBlock Text="监听地址" VerticalAlignment="Center"/>
                <TextBox x:Name="UrlTextBox" Grid.Column="1" Text="http://0.0.0.0:5050" Margin="4,0,12,0" VerticalContentAlignment="Center"/>
                <Button x:Name="StartButton" Grid.Column="2" Content="启动" Margin="4,0" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Grid.Column="3" Content="停止" Margin="4,0" Click="StopButton_Click" IsEnabled="False" Background="#EF6A78"/>
            </Grid>
        </GroupBox>
        <Border Grid.Row="2" Background="#F9FFFFFF" BorderBrush="#E4E8F2" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16">
            <StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#EF6A78" Margin="0,0,9,0"/><TextBlock Text="当前状态  "/><TextBlock x:Name="StatusTextBlock" Text="未启动" FontWeight="Bold" Foreground="#A33"/></StackPanel>
        </Border>
        <GroupBox Grid.Row="3"><GroupBox.Header><StackPanel Orientation="Horizontal"><TextBlock Text="实时请求日志"/><TextBlock Text="查看日志" Foreground="#278BF5" Cursor="Hand" Margin="22,0,0,0" TextDecorations="Underline" MouseLeftButtonDown="ViewLogs_MouseLeftButtonDown"/></StackPanel></GroupBox.Header>
            <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </GroupBox>
        <TextBlock Grid.Row="4" Text="Copyright ©2026 深圳凯中精密技术股份有限公司 版权所有 by tanxianzhong" HorizontalAlignment="Right" Foreground="#7A91A3" FontSize="12" Margin="0,10,2,0"/>
    </Grid>
</Window>
